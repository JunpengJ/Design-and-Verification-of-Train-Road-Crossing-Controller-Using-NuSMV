-- Barrier module
MODULE barrier(traffic_state, train_state, emergency, red_timer)
VAR
	-- State of the barrier: raising, raised, lowering, lowered
	state:{raising, raised, lowering, lowered};
	-- Timer to track the movement of the barrier
	move_timer: 0..10;
ASSIGN
	-- Initial state of the barrier is raised
	init(state) := raised;
	-- Initial movement timer is set to 0
	init(move_timer) := 0;
	next(state) := case
		-- Transition to lowered state when lowering and timer reaches 10
		(state = lowering) & (move_timer >= 10) : lowered;
		-- Transition to raised state when raising and timer reaches 10
		(state = raising) & (move_timer >= 10) : raised;
		-- Emergency forces the barrier to lower
		emergency & (state = raising) : lowering;
		emergency & (state = raised) : lowering;
		-- Raise the barrier when no emergency, train is absent, and traffic light is red
		!emergency & (state = lowered) & (train_state = absent) & (traffic_state = red) : raising;
		-- Lower the barrier when no emergency, traffic light is red, and red timer >= 5
		!emergency & (state = raised) & (traffic_state = red) & (red_timer >= 5) : lowering;
		-- Default case: retain current state
		TRUE: state;
	esac;
	next(move_timer) := case
		-- Start movement timer when transitioning to lowering or raising
		(next(state) = lowering | next(state) = raising) & (state != next(state)) : 1;
		-- Increment timer while lowering or raising
		(state = lowering | state = raising) & (move_timer < 10) : move_timer + 1;
		-- Reset timer when barrier is fully raised or lowered
		(next(state) = raised | next(state) = lowered) : 0;
		-- Default case: retain current timer value
		TRUE : move_timer;
	esac;

-- Traffic light module
MODULE traffic_light(train_state, barrier_state, emergency)
VAR
	-- State of the traffic light: green, yellow, red
	state:{green, yellow, red};
	-- Timer to track the duration of the red light
	red_timer: 0..5;
ASSIGN
	-- Initial state of the traffic light is green
	init(state) := green;
	-- Initial red timer is set to 0
	init(red_timer) := 0;
	next(state) := case
		-- Emergency forces the traffic light to red
		emergency : red;
		-- Transition from green to yellow when train is approaching
		(state = green) & (train_state = approaching) : yellow;
		-- Transition from yellow to red
		(state = yellow) : red;
		-- Transition from red to green when train is absent, barrier is raised, and no emergency
		(state = red) & (train_state = absent) & (barrier_state = raised) & !emergency : green;
		-- Default case: retain current state
		TRUE: state;
	esac;
	next(red_timer) := case
		-- Reset red timer during emergency
		emergency : 0;
		-- Increment red timer while in red state
		state = red & red_timer < 5 :
			red_timer + 1;
		-- Reset red timer when not in red state
		state != red : 0;
		-- Default case: retain current timer value
		TRUE : red_timer;
	esac;

-- Train module
MODULE train(barrier_state, emergency)
VAR
	-- State of the train: approaching, passing, absent
	state: {approaching, passing, absent};
ASSIGN
	-- Initial state of the train is absent
	init(state) := absent;
	next(state) := case
		emergency : approaching; -- In emergency, set train to approaching to simulate imitate S3 in program graph 
		state = absent : {absent, approaching};
		-- Train starts passing when barrier is lowered and no emergency
		(state = approaching) & (barrier_state = lowered) & !emergency : passing;
		-- Train can remain passing or become absent
		state = passing : {passing, absent} ;
		-- Default case: retain current state
		TRUE : state;
	esac;

-- Main module
MODULE main
VAR
	-- Instances of the traffic light, barrier, and train modules
	traffic_light: process traffic_light(train.state, barrier.state, emergency);
	barrier: process barrier(traffic_light.state, train.state, emergency, traffic_light.red_timer);
	train: process train(barrier.state, emergency);
	-- Emergency-related variables
	emergency : boolean;
	emergency_request: boolean;
	emergency_locked : boolean;

ASSIGN
	-- Initial values for emergency-related variables
	init(emergency) := FALSE;
	init(emergency_request) := FALSE;
	init(emergency_locked) := FALSE;

	next(emergency_request) := {TRUE, FALSE};
	next(emergency_locked) := case
		-- Lock emergency when requested and barrier is not lowering or lowered
		emergency_request & (barrier.state != lowering) & (barrier.state != lowered) : TRUE;
		-- Unlock emergency when barrier is fully lowered
		(barrier.state = lowering) & (barrier.move_timer >= 10) & (next(barrier.state) = lowered) : FALSE;
		-- Unlock emergency when request is canceled and barrier is lowered
		!emergency_request & (barrier.state = lowered) : FALSE;
		-- Default case: retain current lock state
		TRUE : emergency_locked;
	esac;
	next(emergency) := case
		-- Emergency is active when locked
		emergency_locked : TRUE;
		-- Default case: follow emergency request
		TRUE : emergency_request;
	esac;

	-- Justice properties to ensure system behavior
	JUSTICE !emergency;
	JUSTICE emergency -> barrier.running;

	-- Invariant properties to ensure safety
	INVAR (train.state = passing -> barrier.state = lowered);
	INVAR (emergency -> traffic_light.state = red);

	-- Fairness constraints for processes
	FAIRNESS running;
	FAIRNESS traffic_light.running;
	FAIRNESS barrier.running;
	FAIRNESS train.running;

-- Security properties
LTLSPEC G!(train.state = passing & barrier.state != lowered)
LTLSPEC G(barrier.state = raised -> X train.state != passing)
LTLSPEC G(emergency -> F(!emergency))

-- Liveness properties
LTLSPEC G((train.state = approaching & !emergency & traffic_light.state = red & traffic_light.red_timer >= 5) -> F barrier.state = lowered)
LTLSPEC G((barrier.state = lowering & barrier.move_timer > 0) -> (barrier.state = lowering U barrier.state = lowered))

-- Emergency properties
CTLSPEC AG(emergency -> AF traffic_light.state = red)
CTLSPEC AG(emergency -> AF barrier.state = lowered)
CTLSPEC EF(barrier.state = raising & emergency & AF barrier.state = lowering)
LTLSPEC G(emergency -> F (!emergency & barrier.state = lowered))

-- Deadlock detection
CTLSPEC AG EX TRUE