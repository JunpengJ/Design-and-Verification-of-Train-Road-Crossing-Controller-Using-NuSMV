-- Barrier module
MODULE barrier(traffic_state, train_state, emergency, red_timer)
VAR
	state:{raising, raised, lowering, lowered};
	move_timer: 0..10;
ASSIGN
	init(state) := raised;
	init(move_timer) := 0;
	next(state) := case
		emergency : lowering;
		(state = raised) & (traffic_state = red) & (red_timer >= 5) : lowering;
		(state = lowering) & (move_timer >= 10) : lowered;
		(state = lowered) & (train_state = absent) & (traffic_state = red) : raising;
		(state = raising) & (move_timer >= 10) : raised;
		TRUE: state;
	esac;
	next(move_timer) := case
		emergency & state != lowering : 1;
		(state = lowering | state = raising) & (move_timer < 10) : move_timer + 1;
		state = raised | state = lowered : 0;
		next(state) != state : 0;
		TRUE : move_timer;
	esac;

-- Traffic light module
MODULE traffic_light(train_state, barrier_state, emergency)
VAR
	state:{green, yellow, red};
	red_timer: 0..5;
ASSIGN
	init(state) := green;
	init(red_timer) := 0;
	next(state) := case
		emergency : red;
		(state = green) & (train_state = approaching) : yellow;
		(state = yellow) : red;
		(state = red) & (train_state = absent) & (barrier_state = raised) & !emergency : green;
		TRUE: state;
	esac;
	next(red_timer) := case
		emergency : 0;
		state = red & red_timer < 5 :
			red_timer + 1;
		state != red : 0;
		TRUE : red_timer;
	esac;

-- Train module
MODULE train(barrier_state, emergency)
VAR
	state: {approaching, passing, absent};
ASSIGN
	init(state) := absent;
	next(state) := case
		emergency : approaching; -- In emergency, set train to approaching to simulate imitate S3 in program graph 
		state = absent : {absent, approaching};
		(state = approaching) & (barrier_state = lowered) & !emergency : passing;
		state = passing : {passing, absent} ;
		TRUE : state;
	esac;

	INVAR (emergency -> state != passing);

-- Main module
MODULE main
VAR
	emergency : boolean;
	traffic_light: process traffic_light(train.state, barrier.state, emergency);
	barrier: process barrier(traffic_light.state, train.state, emergency, traffic_light.red_timer);
	train: process train(barrier.state, emergency);
	emergency_button: boolean;
ASSIGN
	init(emergency) := FALSE;
	next(emergency) := {FALSE, TRUE};

	FAIRNESS running;
	FAIRNESS traffic_light.running;
	FAIRNESS barrier.running;
	FAIRNESS train.running;
	FAIRNESS !emergency;

-- Security
LTLSPEC G!(train.state = passing & barrier.state != lowered)
LTLSPEC G(barrier.state = raised -> X train.state != passing)

--CTLSPEC AG((barrier.state != raised & barrier.state != lowering & barrier.state != raising & !emergency) -> traffic_light.state = red)
--CTLSPEC AG((barrier.state = lowering & !emergency) -> traffic_light.red_timer >= 5)

LTLSPEC G(emergency -> F(!emergency))

-- Liveness
LTLSPEC G((train.state = approaching & !emergency) -> F barrier.state = lowered)
--LTLSPEC G((train.state = absent & barrier.state = lowered & !emergency & traffic_light.state = red) -> F barrier.state = raised)

-- Emergency 
CTLSPEC AG(emergency -> (AF traffic_light.state = red & AF barrier.state = lowering))

-- Dead Lock
CTLSPEC AG EX TRUE